APP_NAME="Backend API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# MongoDB connection string
MONGO_DB_URL="mongodb://localhost:27017"
MONGO_DB_NAME="zamp_db"

# Optional overrides (defaults live in app/core/config.py)
# CORS_ORIGINS=["http://localhost:5173"]
# MAX_UPLOAD_MB=20
# MAX_PAGES=50
# OCR_DPI=300

# NVIDIA API key for Nemotron Parse. Leave empty to read scanned pages with local OCR.
NVIDIA_KEY=""

# The LLM that detects POs and compares documents. It also uses NVIDIA_KEY.
# LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
# ACCEPT_TOLERANCE_PERCENT=2
# REJECT_TOLERANCE_PERCENT=10
